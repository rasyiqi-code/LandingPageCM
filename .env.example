# App Configuration
NEXT_PUBLIC_APP_URL="https://crediblemark.com"

# Email (Resend) — wajib agar form kontak, lead, dan testimoni terkirim via email
RESEND_API_KEY="re_your_api_key"
ADMIN_EMAIL="support@crediblemark.com"

# Branding (opsional — sudah ada default di lib/server/settings.ts)
NEXT_PUBLIC_AGENCY_NAME="Crediblemark"
NEXT_PUBLIC_AGENCY_LOGO="/logo.webp"
CONTACT_PHONE="+6285183131249"

# GitHub (opsional — portfolio publik tetap tampil, token meningkatkan rate limit)
GITHUB_PAT=""

# Cloudflare (opsional — dipakai untuk render portfolio yang memblokir iframe)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""